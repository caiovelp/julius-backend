FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_APP_ID=your-app-id
FIREBASE_MEASUREMENT_ID=your-measurement-id

# Authentication (optional)
# Set to 'true' to enable authentication on CRUD endpoints
# When 'false' (default), all endpoints are accessible without tokens
AUTH_ENABLED=false

# Guest/Demo user ID (used when AUTH_ENABLED=false)
# Change this to match your demo user in the database
GUEST_USER_ID=1

